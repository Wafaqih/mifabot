{
  "name": "mifabot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot administrasi santri MIFABOT berbasis WhatsApp.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "bot": "tsx src/index.ts",
    "predb:check": "npm run build",
    "db:check": "node dist/scripts/db-check.js",
    "predb:migrate": "npm run build",
    "db:migrate": "node dist/scripts/migrate.js",
    "predb:seed": "npm run build",
    "db:seed": "node dist/scripts/seed.js",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc.13",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "googleapis": "^176.0.0",
    "pg": "^8.23.0",
    "pino": "^9.9.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
